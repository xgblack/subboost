generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model LocalAdmin {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  allowUnsafeSubscriptionSources Boolean @default(false)

  subscriptions Subscription[]
  templates      LocalTemplate[]
}

model LocalTemplate {
  id              String   @id @default(cuid())
  ownerId         String
  name            String
  description     String?
  encryptedConfig String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner LocalAdmin @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([updatedAt])
}

model Subscription {
  id                            String    @id @default(cuid())
  ownerId                       String
  name                          String
  token                         String    @unique
  isPrimary                     Boolean   @default(false)
  encryptedUrls                 String    @db.Text
  encryptedNodes                String    @db.Text
  encryptedConfig               String    @db.Text
  encryptedSubscriptionInfo     String?   @db.Text
  autoUpdateInterval            Int?
  cacheExpiresAt                DateTime?
  lastAccessedAt                DateTime?
  lastUpdatedAt                 DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  owner           LocalAdmin                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  autoUpdateState SubscriptionAutoUpdateState?
  sourceUpdateStates SubscriptionSourceUpdateState[]
  sourceUpdateLogs SubscriptionSourceUpdateLog[]

  @@index([ownerId])
  @@index([lastUpdatedAt])
}

model SubscriptionAutoUpdateState {
  subscriptionId           String    @id
  externalFailureCount     Int       @default(0)
  failureSourceState       String?   @db.Text
  lastFailedAt             DateTime?
  lastAttemptedAt          DateTime?
  nodeQuotaFailureCount    Int       @default(0)
  lastNodeQuotaExceededAt  DateTime?
  lastNodeQuotaActual      Int?
  lastNodeQuotaLimit       Int?
  disabledAt               DateTime?
  disabledReason           String?
  disabledPreviousInterval Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model JobLeaseLock {
  name       String   @id
  ownerToken String
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}

enum SubscriptionSourceUpdateResult {
  applied
  unchanged
  failed
  not_applied
}

enum SubscriptionSourceUpdateTrigger {
  automatic
  manual_all
  manual_source
}

model SubscriptionSourceUpdateState {
  subscriptionId   String
  sourceId         String
  lastAttemptedAt  DateTime
  lastResult       SubscriptionSourceUpdateResult
  lastSuccessfulAt DateTime?
  lastError        String? @db.VarChar(240)
  nodeCount        Int
  warningCount     Int @default(0)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, sourceId])
}

model SubscriptionSourceUpdateLog {
  id              String @id @default(cuid())
  subscriptionId  String
  sourceId        String
  sourceType      String
  sourceLabel     String @db.VarChar(240)
  trigger         SubscriptionSourceUpdateTrigger
  startedAt       DateTime
  completedAt     DateTime
  durationMs      Int
  result          SubscriptionSourceUpdateResult
  nodeCountBefore Int
  nodeCountAfter  Int
  nodesChanged    Boolean
  warningCount    Int @default(0)
  errorCategory   String?
  httpStatus      Int?
  errorMessage    String? @db.VarChar(240)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, sourceId, completedAt, id], map: "SubscriptionSourceUpdateLog_source_history_idx")
}

model RevokedSession {
  revocationKey String   @id
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}
